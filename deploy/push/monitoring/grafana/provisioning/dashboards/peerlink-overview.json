    {
      "id": 8,
      "type": "timeseries",
      "title": "New Users",
      "datasource": {
        "type": "postgres",
        "uid": "peerlink-observability-db"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "peerlink-observability-db"
          },
          "rawSql": "with users as (select user_id, min(created_at) as first_seen from push_devices group by user_id) select date_trunc('day', first_seen) as time, count(*) as new_users from users where $__timeFilter(first_seen) group by 1 order by 1",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Total Users Over Time",
      "datasource": {
        "type": "postgres",
        "uid": "peerlink-observability-db"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "peerlink-observability-db"
          },
          "rawSql": "with users as (select user_id, min(created_at) as first_seen from push_devices group by user_id), daily as (select date_trunc('day', first_seen) as day, count(*) as new_users from users where first_seen <= $__timeTo() group by 1), cumulative as (select day, sum(new_users) over (order by day) as total_users from daily) select day as time, total_users from cumulative where day >= $__timeFrom() order by day",
          "format": "time_series"
        }
      ]
    },
