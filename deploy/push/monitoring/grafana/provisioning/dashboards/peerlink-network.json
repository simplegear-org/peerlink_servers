      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "peerlink-observability-db"
          },
          "rawSql": "with ranked as (select server_id, sum(message_count + call_count) as total_events from server_usage_hourly where bucket_at >= now() - interval '7 days' group by server_id order by total_events desc limit 10) select u.bucket_at as time, s.normalized_url as metric, sum(u.message_count) as value from server_usage_hourly u join observed_servers s on s.id = u.server_id join ranked r on r.server_id = u.server_id where $__timeFilter(u.bucket_at) group by 1,2 order by 1",
          "format": "time_series"
        }
      ]
    },
