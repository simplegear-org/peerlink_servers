PUSH_PUBLIC_HOST=push.example.com
LETSENCRYPT_EMAIL=ops@example.com
PUSH_TLS_PROVIDER=letsencrypt
# Optional: override GitHub-built image names used by docker-compose.push.yml.
# PUSH_IMAGE=tangash/push:1.4.0-2026082607
# SERVER_CHECKER_IMAGE=tangash/server-checker:1.4.0-2026082607
# For orange-cloud Cloudflare proxy use:
# PUSH_TLS_PROVIDER=cloudflare_origin
# PUSH_ORIGIN_CERT_PEM='-----BEGIN CERTIFICATE-----\nCHANGE_ME\n-----END CERTIFICATE-----'
# PUSH_ORIGIN_KEY_PEM='-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----'
APNS_TEAM_ID=change_me
APNS_KEY_ID=change_me
APNS_PRIVATE_KEY=change_me
APNS_VOIP_TOPIC=change_me
APNS_MESSAGES_TOPIC=change_me
APNS_USE_SANDBOX=true/false
PUSH_API_TOKEN=change_me
# allow keeps old clients without /devices/access-policy compatible.
# Set to drop only after client rollout is complete.
PUSH_ACCESS_POLICY_MISSING_SNAPSHOT_MODE=allow
MODERATION_ADMIN_TOKEN=change_me
MODERATION_WARNING_REPORT_THRESHOLD=10
MODERATION_BAN_REPORT_THRESHOLD=20
FCM_PROJECT_ID=change_me
FCM_CREDENTIALS_JSON='{"type":"service_account","project_id":"change_me","private_key_id":"change_me","private_key":"-----BEGIN PRIVATE KEY-----\\nCHANGE_ME\\n-----END PRIVATE KEY-----\\n","client_email":"change_me","client_id":"change_me","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Observability: Postgres stores observed self-hosted servers, Prometheus/Grafana
# expose metrics and dashboards only on the origin host.
PUSH_OBSERVABILITY_POSTGRES_PASSWORD=change_me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
PEERLINK_SERVER_CHECK_INTERVAL_MS=300000
PEERLINK_SERVER_CHECK_TIMEOUT_MS=5000
